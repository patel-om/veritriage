<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TraceIQ — {{ report.summary.test_name or report.input_file }}</title>
<style>
  :root {
    color-scheme: light;
    --page:           #f9f9f7;
    --surface:        #fcfcfb;
    --ink:            #0b0b0b;
    --ink-2:          #52514e;
    --muted:          #898781;
    --hairline:       rgba(11,11,11,0.10);
    --grid:           #e1e0d9;
    --meter:          #2a78d6;   /* sequential blue: confidence is a magnitude */
    --meter-track:    #e1e0d9;
    --good:           #0ca30c;
    --warning:        #fab219;
    --serious:        #ec835a;
    --critical:       #d03b3b;
    --code-bg:        #f3f2ee;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --page:        #0d0d0d;
      --surface:     #1a1a19;
      --ink:         #ffffff;
      --ink-2:       #c3c2b7;
      --muted:       #898781;
      --hairline:    rgba(255,255,255,0.10);
      --grid:        #2c2c2a;
      --meter:       #3987e5;
      --meter-track: #2c2c2a;
      --code-bg:     #232322;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page:        #0d0d0d;
    --surface:     #1a1a19;
    --ink:         #ffffff;
    --ink-2:       #c3c2b7;
    --muted:       #898781;
    --hairline:    rgba(255,255,255,0.10);
    --grid:        #2c2c2a;
    --meter:       #3987e5;
    --meter-track: #2c2c2a;
    --code-bg:     #232322;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 32px 20px 64px; }

  header.masthead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 8px; }
  .brand { font-size: 20px; font-weight: 700; letter-spacing: 0.02em; }
  .brand small { font-weight: 400; color: var(--muted); font-size: 12px; margin-left: 6px; }
  .meta { color: var(--ink-2); font-size: 13px; margin: 0 0 24px; }
  .meta code { color: var(--ink-2); }

  section { margin-top: 28px; }
  h2 { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 12px; }

  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 18px 20px;
  }

  /* Stat tiles */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .tile { background: var(--surface); border: 1px solid var(--hairline); border-radius: 10px; padding: 14px 16px; }
  .tile .label { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--ink-2); }
  .tile .value { font-size: 28px; font-weight: 700; color: var(--ink); margin-top: 2px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
  .dot.good { background: var(--good); } .dot.warning { background: var(--warning); }
  .dot.serious { background: var(--serious); } .dot.critical { background: var(--critical); }
  .dot.muted { background: var(--muted); }

  /* Classification */
  .verdict { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--hairline); border-radius: 999px;
    padding: 5px 14px; font-weight: 600; font-size: 15px;
  }
  .verdict-summary { color: var(--ink-2); margin: 10px 0 0; }
  .rule-name { color: var(--muted); font-size: 12px; }

  .meter { margin-top: 16px; }
  .meter .meter-head { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-2); margin-bottom: 6px; }
  .meter .meter-head b { color: var(--ink); font-size: 15px; }
  .meter .track { height: 8px; border-radius: 4px; background: var(--meter-track); overflow: hidden; }
  .meter .fill { height: 100%; border-radius: 4px; background: var(--meter); }

  /* Evidence timeline */
  ol.timeline { list-style: none; margin: 0; padding: 0; }
  ol.timeline li { position: relative; padding: 0 0 16px 22px; border-left: 2px solid var(--grid); margin-left: 6px; }
  ol.timeline li:last-child { padding-bottom: 0; }
  ol.timeline li::before {
    content: ""; position: absolute; left: -6px; top: 4px;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--meter);
  }
  .ev-when { font-size: 12px; color: var(--muted); }
  .ev-desc { margin: 2px 0 0; overflow-wrap: anywhere; }

  /* Snippets & tables */
  pre.snippet {
    background: var(--code-bg); border: 1px solid var(--hairline); border-radius: 8px;
    padding: 12px 14px; overflow-x: auto; font: 12.5px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--ink-2); margin: 0;
  }
  pre.snippet .ln { color: var(--muted); user-select: none; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th { text-align: left; color: var(--muted); font-weight: 600; font-size: 12px; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--grid); }
  td { padding: 7px 12px 7px 0; border-bottom: 1px solid var(--grid); color: var(--ink-2); vertical-align: top; }
  td.num { font-variant-numeric: tabular-nums; }

  /* Next steps */
  ol.steps { margin: 0; padding-left: 20px; }
  ol.steps li { margin-bottom: 12px; }
  ol.steps .why { display: block; color: var(--muted); font-size: 13px; }

  .placeholder { border-style: dashed; color: var(--muted); }
  footer { margin-top: 40px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div class="brand">TraceIQ<small>verification intelligence</small></div>
  </header>
  <p class="meta">
    {% if report.summary.test_name %}Test <code>{{ report.summary.test_name }}</code> ·{% endif %}
    {% if report.summary.simulator %}{{ report.summary.simulator }} ·{% endif %}
    <code>{{ report.input_file }}</code> ·
    generated {{ report.generated_at.strftime("%Y-%m-%d %H:%M UTC") }} ·
    parser <code>{{ report.parser_name }}</code>
  </p>

  <section>
    <h2>Regression Summary</h2>
    <div class="tiles">
      <div class="tile"><div class="label"><span class="dot critical"></span>Fatals</div><div class="value">{{ fatal_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot serious"></span>Errors</div><div class="value">{{ error_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot warning"></span>Warnings</div><div class="value">{{ warning_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot muted"></span>Failed assertions</div><div class="value">{{ assertion_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot muted"></span>Log lines</div><div class="value">{{ report.summary.total_lines }}</div></div>
    </div>
  </section>

  <section>
    <h2>Failure Classification</h2>
    <div class="card">
      <div class="verdict">
        <span class="chip"><span class="dot {{ status_role }}"></span>{{ report.classification.category.display_name }}</span>
        <span class="rule-name">rule: {{ report.classification.rule_name }}</span>
      </div>
      <p class="verdict-summary">{{ report.classification.summary }}</p>
      <div class="meter">
        <div class="meter-head"><span>Confidence</span><b>{{ report.classification.confidence }}%</b></div>
        <div class="track"><div class="fill" style="width: {{ report.classification.confidence }}%"></div></div>
      </div>
      {% if report.alternatives %}
      <div style="margin-top: 18px;">
        <table>
          <thead><tr><th>Alternative classification</th><th>Confidence</th><th>Rule</th></tr></thead>
          <tbody>
          {% for alt in report.alternatives %}
            <tr><td>{{ alt.category.display_name }}</td><td class="num">{{ alt.confidence }}%</td><td>{{ alt.rule_name }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>
  </section>

  {% if report.classification.evidence %}
  <section>
    <h2>Evidence Timeline</h2>
    <div class="card">
      <ol class="timeline">
      {% for ev in report.classification.evidence %}
        <li>
          <div class="ev-when">
            {% if ev.sim_time %}t = {{ ev.sim_time }}{% endif %}
            {% if ev.line_number %}{% if ev.sim_time %} · {% endif %}log line {{ ev.line_number }}{% endif %}
          </div>
          <p class="ev-desc">{{ ev.description }}</p>
        </li>
      {% endfor %}
      </ol>
    </div>
  </section>

  <section>
    <h2>Relevant Log Snippets</h2>
    <pre class="snippet">{% for ev in report.classification.evidence %}{% if ev.snippet %}<span class="ln">{{ "%6d" | format(ev.line_number or 0) }} │ </span>{{ ev.snippet }}
{% endif %}{% endfor %}</pre>
  </section>
  {% endif %}

  {% if report.classification.recommendations %}
  <section>
    <h2>Suggested Next Steps</h2>
    <div class="card">
      <ol class="steps">
      {% for rec in report.classification.recommendations | sort(attribute="priority") %}
        <li>{{ rec.action }}<span class="why">{{ rec.rationale }}</span></li>
      {% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}

  {% if report.ai_summary %}
  <section>
    <h2>AI Summary</h2>
    <div class="card">
      <p style="margin: 0; white-space: pre-wrap;">{{ report.ai_summary }}</p>
      <p style="margin: 12px 0 0; font-size: 12px; color: var(--muted);">
        Generated by the optional AI layer from the evidence above. Verify against the log before acting.
      </p>
    </div>
  </section>
  {% endif %}

  <section>
    <h2>Waveform</h2>
    <div class="card placeholder">
      Waveform jump — planned for a future version. TraceIQ will link each piece of
      evidence to a time window in the FSDB/VCD so you can open the waveform at the
      moment behavior diverged.
    </div>
  </section>

  <footer>TraceIQ · deterministic parsing → rule engine → evidence-backed report. Every conclusion above traces to a log line.</footer>
</div>
</body>
</html>
