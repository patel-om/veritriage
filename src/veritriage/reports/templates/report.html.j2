<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VeriTriage - {{ report.summary.test_name or report.input_files[0] }}</title>
<style>
  :root {
    color-scheme: light;
    --page:           #f9f9f7;
    --surface:        #fcfcfb;
    --ink:            #0b0b0b;
    --ink-2:          #52514e;
    --muted:          #898781;
    --hairline:       rgba(11,11,11,0.10);
    --grid:           #e1e0d9;
    --meter:          #2a78d6;   /* sequential blue: confidence is a magnitude */
    --meter-track:    #e1e0d9;
    --good:           #0ca30c;
    --warning:        #fab219;
    --serious:        #ec835a;
    --critical:       #d03b3b;
    --code-bg:        #f3f2ee;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --page:        #0d0d0d;
      --surface:     #1a1a19;
      --ink:         #ffffff;
      --ink-2:       #c3c2b7;
      --muted:       #898781;
      --hairline:    rgba(255,255,255,0.10);
      --grid:        #2c2c2a;
      --meter:       #3987e5;
      --meter-track: #2c2c2a;
      --code-bg:     #232322;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page:        #0d0d0d;
    --surface:     #1a1a19;
    --ink:         #ffffff;
    --ink-2:       #c3c2b7;
    --muted:       #898781;
    --hairline:    rgba(255,255,255,0.10);
    --grid:        #2c2c2a;
    --meter:       #3987e5;
    --meter-track: #2c2c2a;
    --code-bg:     #232322;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 32px 20px 64px; }

  header.masthead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 8px; }
  .brand { font-size: 20px; font-weight: 700; letter-spacing: 0.02em; }
  .brand small { font-weight: 400; color: var(--muted); font-size: 12px; margin-left: 6px; }
  .meta { color: var(--ink-2); font-size: 13px; margin: 0 0 24px; }
  .meta code { color: var(--ink-2); }

  section { margin-top: 28px; }
  h2 { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 12px; }

  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 18px 20px;
  }

  /* Stat tiles */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .tile { background: var(--surface); border: 1px solid var(--hairline); border-radius: 10px; padding: 14px 16px; }
  .tile .label { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--ink-2); }
  .tile .value { font-size: 28px; font-weight: 700; color: var(--ink); margin-top: 2px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
  .dot.good { background: var(--good); } .dot.warning { background: var(--warning); }
  .dot.serious { background: var(--serious); } .dot.critical { background: var(--critical); }
  .dot.muted { background: var(--muted); }

  /* Classification */
  .verdict { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--hairline); border-radius: 999px;
    padding: 5px 14px; font-weight: 600; font-size: 15px;
  }
  .verdict-summary { color: var(--ink-2); margin: 10px 0 0; }
  .rule-name { color: var(--muted); font-size: 12px; }

  .meter { margin-top: 16px; }
  .meter .meter-head { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-2); margin-bottom: 6px; }
  .meter .meter-head b { color: var(--ink); font-size: 15px; }
  .meter .track { height: 8px; border-radius: 4px; background: var(--meter-track); overflow: hidden; }
  .meter .fill { height: 100%; border-radius: 4px; background: var(--meter); }

  /* Evidence timeline */
  ol.timeline { list-style: none; margin: 0; padding: 0; }
  ol.timeline li { position: relative; padding: 0 0 16px 22px; border-left: 2px solid var(--grid); margin-left: 6px; }
  ol.timeline li:last-child { padding-bottom: 0; }
  ol.timeline li::before {
    content: ""; position: absolute; left: -6px; top: 4px;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--surface); border: 2px solid var(--meter);
  }
  .ev-when { font-size: 12px; color: var(--muted); }
  .ev-desc { margin: 2px 0 0; overflow-wrap: anywhere; }

  /* Snippets & tables */
  pre.snippet {
    background: var(--code-bg); border: 1px solid var(--hairline); border-radius: 8px;
    padding: 12px 14px; overflow-x: auto; font: 12.5px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color: var(--ink-2); margin: 0;
  }
  pre.snippet .ln { color: var(--muted); user-select: none; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th { text-align: left; color: var(--muted); font-weight: 600; font-size: 12px; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--grid); }
  td { padding: 7px 12px 7px 0; border-bottom: 1px solid var(--grid); color: var(--ink-2); vertical-align: top; }
  td.num { font-variant-numeric: tabular-nums; }

  /* Next steps */
  ol.steps { margin: 0; padding-left: 20px; }
  ol.steps li { margin-bottom: 12px; }
  ol.steps .why { display: block; color: var(--muted); font-size: 13px; }

  .placeholder { border-style: dashed; color: var(--muted); }
  footer { margin-top: 40px; color: var(--muted); font-size: 12px; }

  /* Investigation */
  p.lead { color: var(--ink-2); margin: 0 0 14px; }
  .hyp-card { margin-bottom: 14px; }
  .ev-refs { margin: 12px 0 0; font-size: 12.5px; color: var(--muted); }
  .ev-refs code { color: var(--ink-2); }
  .ai-note { margin: 10px 0 0; color: var(--ink-2); font-size: 13.5px; border-left: 3px solid var(--meter); padding-left: 10px; }
  details { margin-top: 12px; }
  details summary { cursor: pointer; color: var(--muted); font-size: 12.5px; }
  details[open] summary { margin-bottom: 8px; }

  /* Knowledge: protocol sequence stepper */
  .kseq { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px 4px; }
  .kstate {
    display: flex; flex-direction: column; gap: 3px;
    border: 1px solid var(--hairline); border-radius: 8px;
    padding: 7px 12px; font-size: 12.5px; font-weight: 600; color: var(--ink);
  }
  .kstate .kdot { width: 9px; height: 9px; border-radius: 50%; background: var(--meter); }
  .kstate.unreached { color: var(--muted); border-style: dashed; font-weight: 400; }
  .kstate.unreached .kdot { background: var(--meter-track); }
  .kstate.stall { border-color: var(--serious); }
  .kstate.stall .kdot { background: var(--serious); }
  .kstate .kev { font-weight: 400; font-size: 11px; color: var(--muted); }
  .kstate .kev code { color: var(--ink-2); }
  .karrow { color: var(--muted); align-self: center; }

  /* Evidence graph drawing */
  .graph-scroll { overflow-x: auto; margin-top: 14px; }
  svg.evgraph { display: block; }
  svg.evgraph text { font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; fill: var(--ink-2); }
  svg.evgraph text.col-label { font: 600 11px system-ui, sans-serif; fill: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  svg.evgraph line.edge { stroke: var(--muted); stroke-width: 1.2; opacity: 0.55; }
  svg.evgraph circle { stroke: var(--surface); stroke-width: 2; }
  svg.evgraph circle.critical { fill: var(--critical); }
  svg.evgraph circle.serious { fill: var(--serious); }
  svg.evgraph circle.warning { fill: var(--warning); }
  svg.evgraph circle.muted { fill: var(--muted); }
</style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div class="brand">VeriTriage<small>verification intelligence</small></div>
  </header>
  <p class="meta">
    {% if report.summary.test_name %}Test <code>{{ report.summary.test_name }}</code> ·{% endif %}
    {% if report.summary.simulator %}{{ report.summary.simulator }} ·{% endif %}
    {% for f in report.input_files %}<code>{{ f }}</code>{% if not loop.last %} + {% endif %}{% endfor %} ·
    generated {{ report.generated_at.strftime("%Y-%m-%d %H:%M UTC") }} ·
    parsers <code>{{ report.parser_names | join(", ") }}</code>
  </p>

  <section>
    <h2>Regression Summary</h2>
    <div class="tiles">
      <div class="tile"><div class="label"><span class="dot critical"></span>Fatals</div><div class="value">{{ fatal_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot serious"></span>Errors</div><div class="value">{{ error_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot warning"></span>Warnings</div><div class="value">{{ warning_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot muted"></span>Failed assertions</div><div class="value">{{ assertion_count }}</div></div>
      <div class="tile"><div class="label"><span class="dot muted"></span>Log lines</div><div class="value">{{ report.summary.total_lines }}</div></div>
    </div>
  </section>

  <section>
    <h2>Evidence Graph</h2>
    <div class="card">
      <p style="margin: 0 0 12px; color: var(--ink-2);">
        {{ report.graph_stats.node_count }} evidence nodes and {{ report.graph_stats.edge_count }}
        relationships extracted from {{ report.input_files | length }} artifact{{ "s" if report.input_files | length != 1 }}.
        Full graph in <code>evidence_graph.json</code>; every conclusion below cites node IDs from it.
      </p>
      {% if graph_viz %}
      <div class="graph-scroll">
        <svg class="evgraph" width="{{ graph_viz.width }}" height="{{ graph_viz.height }}"
             viewBox="0 0 {{ graph_viz.width }} {{ graph_viz.height }}"
             role="img" aria-label="Working-set evidence graph: nodes by artifact type with relationships">
          {% for col in graph_viz.columns %}
          <text class="col-label" x="{{ col.x }}" y="18">{{ col.label }}</text>
          {% endfor %}
          {% for e in graph_viz.edges %}
          <line class="edge" x1="{{ e.x1 }}" y1="{{ e.y1 }}" x2="{{ e.x2 }}" y2="{{ e.y2 }}"
                {% if e.dashed %}stroke-dasharray="4 3"{% endif %}><title>{{ e.tooltip }}</title></line>
          {% endfor %}
          {% for n in graph_viz.nodes %}
          <g>
            <circle class="{{ n.color }}" cx="{{ n.x }}" cy="{{ n.y }}" r="7"><title>{{ n.tooltip }}</title></circle>
            <text x="{{ n.x + 13 }}" y="{{ n.y + 4 }}">{{ n.label }}</text>
          </g>
          {% endfor %}
        </svg>
      </div>
      <p style="margin: 8px 0 0; font-size: 12px; color: var(--muted);">
        Working-set nodes only; hover a node or edge for details. Dashed edges are
        cross-artifact correlations.
      </p>
      {% endif %}
      <table>
        <thead><tr><th>Artifact type</th><th>Nodes</th></tr></thead>
        <tbody>
        {% for artifact_type, count in report.graph_stats.nodes_by_type.items() %}
          <tr><td>{{ artifact_type.replace("_", " ") }}</td><td class="num">{{ count }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% if report.graph_stats.edges_by_relation %}
      <div style="margin-top: 14px;">
        <table>
          <thead><tr><th>Relationship</th><th>Edges</th></tr></thead>
          <tbody>
          {% for relation, count in report.graph_stats.edges_by_relation.items() %}
            <tr><td>{{ relation.replace("_", " ") }}</td><td class="num">{{ count }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>
  </section>

  <section>
    <h2>Failure Classification</h2>
    <div class="card">
      <div class="verdict">
        <span class="chip"><span class="dot {{ status_role }}"></span>{{ report.classification.category.display_name }}</span>
        <span class="rule-name">rule: {{ report.classification.rule_name }}</span>
      </div>
      <p class="verdict-summary">{{ report.classification.summary }}</p>
      <div class="meter">
        <div class="meter-head"><span>Confidence</span><b>{{ report.classification.confidence }}%</b></div>
        <div class="track"><div class="fill" style="width: {{ report.classification.confidence }}%"></div></div>
      </div>
      {% if report.alternatives %}
      <div style="margin-top: 18px;">
        <table>
          <thead><tr><th>Alternative classification</th><th>Confidence</th><th>Rule</th></tr></thead>
          <tbody>
          {% for alt in report.alternatives %}
            <tr><td>{{ alt.category.display_name }}</td><td class="num">{{ alt.confidence }}%</td><td>{{ alt.rule_name }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>
  </section>

  {% if report.reasoning and report.reasoning.hypotheses %}
  <section>
    <h2>Investigation - Competing Hypotheses</h2>
    <p class="lead">
      <b>What happened:</b> {{ report.classification.summary }}.
      <b>Why we believe this:</b> {{ report.reasoning.signals | length }} deterministic
      signal{{ "s" if report.reasoning.signals | length != 1 }} evaluated over
      {{ report.reasoning.working_set.items | length }} selected evidence nodes rank the
      explanations below. Alternatives are shown so nothing is concluded without contrast.
    </p>
    {% for hyp in report.reasoning.hypotheses %}
    <div class="card hyp-card">
      <div class="verdict">
        <span class="chip"><span class="dot {{ hypothesis_role[hyp.category] }}"></span>{{ hyp.title }}</span>
        <span class="rule-name">{{ hyp.category.display_name }} · generator: {{ hyp.generated_by }}</span>
      </div>
      <p class="verdict-summary">{{ hyp.statement }}</p>
      <div class="meter">
        <div class="meter-head"><span>Confidence</span><b>{{ "%.0f" | format(hyp.confidence * 100) }}%</b></div>
        <div class="track"><div class="fill" style="width: {{ (hyp.confidence * 100) | round }}%"></div></div>
      </div>
      <p class="ev-refs">Supporting evidence:
        {% for nid in hyp.evidence_ids %}<code>{{ nid }}</code>{% if not loop.last %} {% endif %}{% endfor %}
      </p>
      {% if hyp.ai_note %}
      <p class="ai-note">AI review: {{ hyp.ai_note }}</p>
      {% endif %}
      <details>
        <summary>Confidence trace</summary>
        <table>
          <thead><tr><th>Step</th><th>Value</th><th>Reason</th></tr></thead>
          <tbody>
            <tr><td>base ({{ hyp.generated_by }})</td><td class="num">{{ "%.2f" | format(hyp.confidence_trace.base) }}</td><td>prior plausibility</td></tr>
            {% for c in hyp.confidence_trace.contributions %}
            <tr><td>signal: {{ c.source }}</td><td class="num">{{ "%+.2f" | format(c.delta) }}</td><td>{{ c.reason }}</td></tr>
            {% endfor %}
            <tr><td>evidence factor</td><td class="num">x{{ "%.2f" | format(hyp.confidence_trace.evidence_factor) }}</td><td>mean extraction confidence of cited nodes</td></tr>
            <tr><td><b>final</b></td><td class="num"><b>{{ "%.2f" | format(hyp.confidence_trace.final) }}</b></td><td></td></tr>
          </tbody>
        </table>
      </details>
    </div>
    {% endfor %}
    {% if report.reasoning.ai_review and report.reasoning.ai_review.missing_evidence %}
    <div class="card placeholder">
      <b>Missing evidence</b> (identified by the AI review): the following would best
      discriminate between hypotheses.
      <ul style="margin: 8px 0 0;">
      {% for item in report.reasoning.ai_review.missing_evidence %}
        <li>{{ item }}</li>
      {% endfor %}
      </ul>
    </div>
    {% endif %}
  </section>

  {% if report.reasoning.recommendations %}
  <section>
    <h2>Recommended Debugging Steps</h2>
    <div class="card">
      <table>
        <thead><tr><th>#</th><th>Action</th><th>Module</th><th>Effort</th><th>Confidence</th></tr></thead>
        <tbody>
        {% for rec in report.reasoning.recommendations %}
          <tr>
            <td class="num">{{ rec.priority }}</td>
            <td>{{ rec.action }}<span class="why" style="display:block; color: var(--muted); font-size: 12.5px;">{{ rec.rationale }}</span></td>
            <td>{{ rec.module or "-" }}</td>
            <td>{{ rec.effort }}</td>
            <td class="num">{{ "%.0f" | format(rec.confidence * 100) }}%</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}
  {% endif %}

  {% if report.knowledge %}
  <section>
    <h2>Verification Knowledge</h2>
    {% if report.knowledge.patterns %}
    <p class="lead">
      The evidence matches {{ report.knowledge.patterns | length }} known verification
      pattern{{ "s" if report.knowledge.patterns | length != 1 }} from the knowledge base
      (packs: {% for pid, v in report.knowledge.pack_versions.items() %}<code>{{ pid }} v{{ v }}</code>{% if not loop.last %}, {% endif %}{% endfor %}).
    </p>
    {% endif %}
    {% for pat in report.knowledge.patterns %}
    <div class="card hyp-card">
      <div class="verdict">
        <span class="chip"><span class="dot {{ ownership_roles.get(pat.pattern_id, "muted") }}"></span>{{ pat.name }}</span>
        <span class="rule-name">{{ pat.pack }} pack v{{ pat.pack_version }} · usually owned by {{ pat.ownership }}</span>
      </div>
      <div class="meter">
        <div class="meter-head"><span>Pattern match</span><b>{{ "%.0f" | format(pat.score * 100) }}%</b></div>
        <div class="track"><div class="fill" style="width: {{ pat.score * 100 }}%"></div></div>
      </div>
      <p class="verdict-summary">{{ pat.summary }}</p>
      {% if pat.typical_causes %}
      <p class="ev-refs" style="margin-top: 10px;"><b>Typical causes:</b></p>
      <ul style="margin: 4px 0 0; color: var(--ink-2); font-size: 13.5px;">
        {% for cause in pat.typical_causes %}<li>{{ cause }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if pat.suggested_signals %}
      <p class="ev-refs"><b>Signals to inspect:</b>
        {% for s in pat.suggested_signals %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
      {% endif %}
      <p class="ev-refs"><b>Matched evidence:</b>
        {% for clause, ids in pat.matched_evidence.items() %}
        {{ clause }} ({% for id in ids %}<code>{{ id }}</code>{% if not loop.last %}, {% endif %}{% endfor %}){% if not loop.last %}; {% endif %}
        {% endfor %}
      </p>
      {% if pat.references %}
      <p class="ev-refs"><b>References:</b>
        {% for ref in pat.references %}{{ ref.source }}{% if ref.section %} §{{ ref.section }}{% endif %}{% if ref.note %} ({{ ref.note }}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}
      </p>
      {% endif %}
      {% if pat.playbook %}
      <details>
        <summary>Debug playbook: {{ pat.playbook.name }} ({{ pat.playbook.steps | length }} deterministic steps)</summary>
        <ol class="steps">
          {% for step in pat.playbook.steps %}
          <li>{{ step.action }}
            {% if step.detail %}<span class="why">{{ step.detail }}</span>{% endif %}
            {% if step.signals %}<span class="why">signals: {% for s in step.signals %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
          </li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}
    </div>
    {% endfor %}

    {% if report.knowledge.state_projection %}
    {% set sp = report.knowledge.state_projection %}
    <div class="card hyp-card">
      <p style="margin: 0 0 12px; color: var(--ink-2);">
        <b style="color: var(--ink);">Expected sequence: {{ sp.name }}</b>
        ({{ sp.pack }} pack). Evidence projected onto the protocol state machine
        {% if sp.stopped_at %} shows progress stopped before <b style="color: var(--ink);">{{ sp.stopped_at }}</b>.{% else %} shows the full sequence completed.{% endif %}
      </p>
      <div class="kseq">
        {% for s in sp.states %}
        <div class="kstate {{ 'reached' if s.reached else 'unreached' }}{{ ' stall' if s.state == sp.stopped_at }}"
             {% if s.description %}title="{{ s.description }}"{% endif %}>
          <span class="kdot"></span>{{ s.state }}
          {% if s.reached and s.evidence_ids %}<span class="kev">{% for id in s.evidence_ids[:2] %}<code>{{ id }}</code>{% endfor %}</span>{% endif %}
        </div>
        {% if not loop.last %}<div class="karrow">&#8594;</div>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if report.knowledge.concepts %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Verification concepts in play</b></p>
      {% for c in report.knowledge.concepts %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <b style="color: var(--ink);">{{ c.name }}</b> <span class="rule-name">({{ c.pack }} pack)</span> · {{ c.summary }}
      </p>
      {% endfor %}
      {% if report.history and report.history.seen_before %}
      <p class="ev-refs" style="margin-top: 12px;">
        <b>Historical support:</b> the regression database holds
        {{ report.history.times_seen }} prior occurrence{{ "s" if report.history.times_seen != 1 }}
        of this exact failure signature.
      </p>
      {% endif %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  {% if report.waveform %}
  <section>
    <h2>Waveform Intelligence</h2>
    {% if report.waveform.observations %}
    <p class="lead">
      The waveform metadata yields {{ report.waveform.observations | length }}
      engineering observation{{ "s" if report.waveform.observations | length != 1 }}
      (adapters: {% for a in report.waveform.adapters %}<code>{{ a.adapter }}</code>{% if not loop.last %}, {% endif %}{% endfor %}).
      No raw transitions are read; every observation is derived from normalized signal-activity metadata.
    </p>
    {% endif %}
    {% for obs in report.waveform.observations %}
    <div class="card hyp-card">
      <div class="verdict">
        <span class="chip"><span class="dot {{ waveform_severity_role.get(obs.severity, "muted") }}"></span>{{ obs.kind.replace("_", " ") }}</span>
        <span class="rule-name">{{ obs.category }} · detected by {{ obs.detector }} ({{ obs.source_adapter }} adapter){% if obs.scope %} · scope {{ obs.scope }}{% endif %}</span>
      </div>
      <div class="meter">
        <div class="meter-head"><span>Confidence</span><b>{{ "%.0f" | format(obs.confidence * 100) }}%</b></div>
        <div class="track"><div class="fill" style="width: {{ obs.confidence * 100 }}%"></div></div>
      </div>
      <p class="verdict-summary">{{ obs.description }}</p>
      {% if obs.signals %}
      <p class="ev-refs"><b>Signals:</b> {% for s in obs.signals %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
        {% if obs.sim_time_start is not none %} · window {{ obs.sim_time_start }}{% if obs.sim_time_end is not none %} to {{ obs.sim_time_end }}{% endif %}{% endif %}
      </p>
      {% endif %}
      <p class="ev-refs"><b>Observation ID:</b> <code>{{ obs.observation_id }}</code></p>
    </div>
    {% endfor %}

    {% if report.waveform.unavailable %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Analyses not available for this run</b> (honest degradation, not "no problem found")</p>
      {% for u in report.waveform.unavailable %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <span class="chip"><span class="dot muted"></span>{{ u.detector }}</span>
        needs <code>{{ u.required_capability }}</code>, which the {{ u.adapter }} adapter does not resolve.
      </p>
      {% endfor %}
    </div>
    {% endif %}

    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Waveform sources</b></p>
      {% for a in report.waveform.adapters %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <b style="color: var(--ink);">{{ a.adapter }}</b> <span class="rule-name">({{ a.format }} format{% if a.simulator %}, {{ a.simulator }}{% endif %})</span>
        · {{ a.signal_count }} signal{{ "s" if a.signal_count != 1 }}{% if a.dump_end is not none %}, dump window {{ a.dump_start }} to {{ a.dump_end }}{% endif %}
        · resolves {% for c in a.capabilities %}<code>{{ c }}</code>{% if not loop.last %} {% endif %}{% endfor %}
      </p>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if report.engineering %}
  <section>
    <h2>Engineering Context</h2>
    <p class="lead">
      What changed before this run broke, from
      {% for s in report.engineering.sources %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.
      Change proximity is evidence, not a verdict: correlated changes shift hypothesis ranking modestly and every claim cites its nodes.
    </p>
    {% for c in report.engineering.commits %}
    <div class="card hyp-card">
      <div class="verdict">
        <span class="chip"><span class="dot {{ 'serious' if c.correlated_failures else 'muted' }}"></span>{{ c.revision[:10] }}</span>
        <span class="rule-name">{{ c.source }} provider{% if c.author %} · {{ c.author }}{% endif %}{% if c.timestamp %} · {{ c.timestamp[:16] }}{% endif %}</span>
      </div>
      <p class="verdict-summary">{{ c.title }}</p>
      {% if c.files %}
      <p class="ev-refs"><b>Changed:</b>
        {% for f in c.files %}<code>{{ f.path }}</code> ({{ f.category }}, +{{ f.lines_added }}/-{{ f.lines_deleted }}){% if not loop.last %}, {% endif %}{% endfor %}
      </p>
      {% endif %}
      {% if c.correlated_failures %}
      <p class="ev-refs"><b>Correlates with failing evidence:</b>
        {% for id in c.correlated_failures %}<code>{{ id }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
      {% endif %}
    </div>
    {% endfor %}

    {% if report.engineering.ci_run %}
    {% set ci = report.engineering.ci_run %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>CI execution</b> ({{ ci.source }} provider)</p>
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        {{ ci.pipeline or "unknown pipeline" }}{% if ci.build_number %} #{{ ci.build_number }}{% endif %}
        {% if ci.simulator %} · {{ ci.simulator }}{% endif %}{% if ci.compiler %} · {{ ci.compiler }}{% endif %}
        {% for k, v in ci.configuration.items() %} · {{ k }}={{ v }}{% endfor %}
      </p>
      {% if ci.environment_changes %}
      <p class="ev-refs" style="margin-top: 8px;"><b>Environment drift:</b>
        {% for change in ci.environment_changes %}{{ change }}{% if not loop.last %}; {% endif %}{% endfor %}
      </p>
      {% endif %}
    </div>
    {% endif %}

    {% if report.engineering.impacted_tests %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Likely impacted tests</b></p>
      {% for t in report.engineering.impacted_tests %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <b style="color: var(--ink);">{{ t.test_name }}</b> ({{ "%.0f" | format(t.score * 100) }}%) · {{ t.reason }}
      </p>
      {% endfor %}
    </div>
    {% endif %}

    {% if report.engineering.ownership %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Ownership</b> (routing advice only; never used for ranking)</p>
      {% for o in report.engineering.ownership %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <code>{{ o.scope }}</code> · {{ o.role }} owner: <b style="color: var(--ink);">{{ o.owner }}</b> <span class="rule-name">({{ o.source }})</span>
      </p>
      {% endfor %}
      {% for i in report.engineering.issues %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <span class="chip"><span class="dot muted"></span>{{ i.tracker_id }}</span> {{ i.title }}{% if i.status %} ({{ i.status }}){% endif %}
      </p>
      {% endfor %}
    </div>
    {% endif %}

    {% if report.engineering.timeline %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Engineering timeline</b></p>
      <ol class="steps">
        {% for event in report.engineering.timeline %}
        <li>[{{ event.phase }}] {{ event.label }}
          {% if event.when %}<span class="why">{{ event.when }}</span>{% endif %}
          {% if event.node_id %}<span class="why"><code>{{ event.node_id }}</code></span>{% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}

    {% if report.engineering.investigation %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Investigation view</b> (a projection of the Evidence Graph, not a separate graph)</p>
      {% for layer in report.engineering.investigation.layers %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <b style="color: var(--ink);">{{ layer.name }}</b> · {{ layer.node_ids | length }} node{{ "s" if layer.node_ids | length != 1 }}:
        {% for id in layer.node_ids[:5] %}<code>{{ id }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
      {% endfor %}
      {% for edge in report.engineering.investigation.cross_edges[:6] %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <code>{{ edge.source_id }}</code> -{{ edge.relation }}-&gt; <code>{{ edge.target_id }}</code>: {{ edge.rationale }}
      </p>
      {% endfor %}
    </div>
    {% endif %}

    {% if report.engineering.unavailable %}
    <div class="card">
      <p class="ev-refs" style="margin: 0 0 8px;"><b>Analyses not available for this run</b> (honest degradation, not "no problem found")</p>
      {% for u in report.engineering.unavailable %}
      <p style="margin: 6px 0 0; color: var(--ink-2); font-size: 13.5px;">
        <span class="chip"><span class="dot muted"></span>{{ u.analysis }}</span>
        needs <code>{{ u.required_capability }}</code>, which no contributing provider resolves.
      </p>
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  {% if report.history %}
  <section>
    <h2>Historical Context</h2>
    <div class="card">
      {% if report.history.seen_before %}
      <p class="lead">
        <span class="chip"><span class="dot serious"></span>Seen before</span>
        This exact failure signature (<code>{{ report.history.signature }}</code>) appears in
        {{ report.history.times_seen }} prior regression{{ "s" if report.history.times_seen != 1 }}
        in the database.
      </p>
      {% elif report.history.similar %}
      <p class="lead">
        <span class="chip"><span class="dot warning"></span>Similar failures found</span>
        No identical signature in the database, but {{ report.history.similar | length }}
        historical failure{{ "s" if report.history.similar | length != 1 }} resemble this one.
      </p>
      {% elif report.classification.category.value != "no_failure" %}
      <p class="lead">
        <span class="chip"><span class="dot good"></span>New failure</span>
        Nothing in the regression database matches this failure; it is new
        (signature <code>{{ report.history.signature }}</code>, recorded as
        <code>{{ report.history.regression_id }}</code>).
      </p>
      {% else %}
      <p class="lead">Clean run, recorded as <code>{{ report.history.regression_id }}</code>.</p>
      {% endif %}
      {% if report.history.similar %}
      <table>
        <thead><tr><th>Regression</th><th>When</th><th>Test</th><th>Classification</th><th>Historical root cause</th><th>Similarity</th></tr></thead>
        <tbody>
        {% for s in report.history.similar %}
          <tr>
            <td><code>{{ s.regression_id }}</code></td>
            <td class="num">{{ s.created_at[:16] | replace("T", " ") }}</td>
            <td>{{ s.test_name or "-" }}</td>
            <td>{{ s.classification | replace("_", " ") | title }}</td>
            <td>{{ s.root_cause }}</td>
            <td class="num">{{ "exact" if s.signature_match else "%.0f%%" | format(s.score * 100) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if report.classification.evidence %}
  <section>
    <h2>Evidence Timeline</h2>
    <div class="card">
      <ol class="timeline">
      {% for ev in report.classification.evidence %}
        <li>
          <div class="ev-when">
            {% if ev.sim_time %}t = {{ ev.sim_time }}{% endif %}
            {% if ev.line_number %}{% if ev.sim_time %} · {% endif %}log line {{ ev.line_number }}{% endif %}
            {% if ev.node_id %} · <code>{{ ev.node_id }}</code>{% endif %}
          </div>
          <p class="ev-desc">{{ ev.description }}</p>
        </li>
      {% endfor %}
      </ol>
    </div>
  </section>

  <section>
    <h2>Relevant Log Snippets</h2>
    <pre class="snippet">{% for ev in report.classification.evidence %}{% if ev.snippet %}<span class="ln">{{ "%6d" | format(ev.line_number or 0) }} │ </span>{{ ev.snippet }}
{% endif %}{% endfor %}</pre>
  </section>
  {% endif %}

  {% if report.classification.recommendations %}
  <section>
    <h2>Suggested Next Steps</h2>
    <div class="card">
      <ol class="steps">
      {% for rec in report.classification.recommendations | sort(attribute="priority") %}
        <li>{{ rec.action }}<span class="why">{{ rec.rationale }}</span></li>
      {% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}

  {% if report.ai_summary %}
  <section>
    <h2>AI Summary</h2>
    <div class="card">
      <p style="margin: 0; white-space: pre-wrap;">{{ report.ai_summary }}</p>
      <p style="margin: 12px 0 0; font-size: 12px; color: var(--muted);">
        Generated by the optional AI layer from the evidence above. Verify against the log before acting.
      </p>
    </div>
  </section>
  {% endif %}

  <section>
    <h2>Waveform</h2>
    <div class="card placeholder">
      Waveform jump - planned for a future version. VeriTriage will link each piece of
      evidence to a time window in the FSDB/VCD so you can open the waveform at the
      moment behavior diverged.
    </div>
  </section>

  <footer>VeriTriage · deterministic parsing → rule engine → evidence-backed report. Every conclusion above traces to a log line.</footer>
</div>
</body>
</html>
